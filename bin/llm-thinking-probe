#!/usr/bin/env python3
"""Find the reasoning switch a serving deployment actually honours.

Chat templates disagree about the name — GLM reads `thinking`, Qwen reads `enable_thinking` — and a
template ignores a variable it does not define rather than complaining. Sending one spelling to a
fleet that uses both therefore measures thinking ON while the row says off, silently. That is not a
thing to remember: it is a thing to run.

The probe sends the same short review prompt once per candidate and compares what comes back
against the no-kwarg baseline. A candidate that empties the reasoning trace is honoured, one that
changes nothing is ignored, one that answers 400 is rejected. The result is the value for
`[lane].extra` in the deployment file, printed as TOML ready to paste.

    bin/llm-thinking-probe --api http://192.168.0.100:8888/v1 --model glm-5.3-flash-nvidia
    bin/dgx-model thinking            # resolves both from whatever is serving, and records the run
"""
import argparse
import json
import pathlib
import sys
import urllib.error
import urllib.request

# The order is the order a lane should prefer: the narrowest switch first, and `reasoning_effort`
# last because it is a request field rather than a template variable and servers read it loosely.
CANDIDATES = [
    ("thinking", {"chat_template_kwargs": {"thinking": False}}),
    ("enable_thinking", {"chat_template_kwargs": {"enable_thinking": False}}),
    ("both", {"chat_template_kwargs": {"thinking": False, "enable_thinking": False}}),
    ("reasoning_effort", {"reasoning_effort": "none"}),
]

# The probe has to use the workload the answer is for. A short puzzle gets answered directly by
# models that think hard about a real review, which made one deployment report "nothing to switch
# off" while its review answers were 6,000 characters of trace behind an empty body. So this is one
# of the review cases, asked exactly as llm-quickbench asks it — and, like there, nothing but the
# language and the code may reach the model.
ROOT = pathlib.Path(__file__).resolve().parent.parent
CASES_PATH = ROOT / "bench/review_cases/cases.json"
ANSWER_KEYS = ("id", "defect", "expected")


def review_prompt(case_id=None):
    """One review case, or a plain fallback if the case file is not beside this script."""
    try:
        cases = json.loads(CASES_PATH.read_text())["cases"]
    except (OSError, ValueError, KeyError):
        return FALLBACK_PROMPT, None
    case = next((c for c in cases if c["id"] == case_id), cases[0])
    prompt = ("Review this %s file as you would in a pull request.\n\n"
              "If something is wrong, say what it is and why it matters, in two or three sentences, "
              "then give the corrected code. If nothing is wrong, say so.\n\n```\n%s```\n"
              % (case["language"], case["code"]))
    low = prompt.lower()
    for key in ANSWER_KEYS:
        value = str(case.get(key, ""))
        if key != "id" and value and value.lower() in low:
            raise SystemExit(f"probe prompt leaks the answer key ({key})")
    return prompt, case["id"]


FALLBACK_PROMPT = ("Review this C# and say what is wrong, in two sentences:\n"
                   "public bool IsStillValid() => Items.Any(i => i.ExpiresAtUtc > DateTime.Now);\n"
                   "// doc: true when EVERY reservation is still valid")
PROMPT, PROMPT_CASE = review_prompt()


def ask(api, model, extra, max_tokens, timeout):
    """One streamed request, because that is how a lane asks.

    Streaming is not a detail here. glm-5.3-flash-himorishige returns a 6,000-character reasoning
    trace and an empty body when streamed, and a plain answer with no trace at all when not — so a
    probe that asks the easy way measures a deployment nobody runs, and reports "nothing to switch
    off" about the deployment whose whole problem is where its findings go. The reconstruction
    below is the one llm-quickbench does, so the two agree about what came back.
    """
    body = {"model": model, "messages": [{"role": "user", "content": PROMPT}],
            "max_tokens": max_tokens, "temperature": 0,
            "stream": True, "stream_options": {"include_usage": True}}
    body.update(extra or {})
    req = urllib.request.Request(api.rstrip("/") + "/chat/completions",
                                 data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    text, trace, finish, reasoning_tokens = [], [], None, None
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            for raw in r:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                chunk = line[5:].strip()
                if chunk == "[DONE]":
                    break
                try:
                    event = json.loads(chunk)
                except ValueError:
                    continue
                for choice in event.get("choices") or []:
                    delta = choice.get("delta") or {}
                    if delta.get("content"):
                        text.append(delta["content"])
                    # vLLM streams the trace as `reasoning`, SGLang as `reasoning_content`.
                    # Reading one of them makes a thinking model look silent: himorishige spent a
                    # whole 1,600-token budget in `reasoning` and the probe saw an empty answer
                    # with nothing to suppress.
                    think = delta.get("reasoning") or delta.get("reasoning_content")
                    if think:
                        trace.append(think)
                    if choice.get("finish_reason"):
                        finish = choice["finish_reason"]
                usage = event.get("usage") or {}
                details = usage.get("completion_tokens_details") or {}
                if details.get("reasoning_tokens") is not None:
                    reasoning_tokens = details["reasoning_tokens"]
    except urllib.error.HTTPError as e:
        return {"http_status": e.code,
                "detail": e.read()[:200].decode("utf-8", "replace").strip()}
    except (urllib.error.URLError, OSError, ValueError) as e:
        return {"error": str(e)[:200]}
    answer = "".join(text).strip()
    return {"body_chars": len(answer),
            "reasoning_chars": len("".join(trace).strip()),
            "reasoning_tokens": reasoning_tokens,
            "finish": finish,
            "sample": answer[:160]}


def reasoning_amount(result):
    """How much reasoning this answer carries, by whichever signal the server offers.

    Two shapes seen on this pair. Most servers fill `reasoning_content`, so the trace can be
    counted in characters. Qwen3.8-Flash-Next leaves that field empty on a non-streamed response
    and reports the trace only as `usage.completion_tokens_details.reasoning_tokens` — 198 tokens
    against an empty string. Reading one signal therefore said "this model never reasons" about a
    deployment that spent most of its budget reasoning, and every switch looked equally pointless.
    """
    return max(result.get("reasoning_chars") or 0, result.get("reasoning_tokens") or 0)


def classify(baseline, result):
    """honoured / ignored / rejected / failed, judged against the no-kwarg answer."""
    if "http_status" in result:
        return "rejected"
    if "error" in result:
        return "failed"
    if not reasoning_amount(baseline):
        # Nothing to suppress: this deployment does not reason even left alone.
        return "no reasoning to suppress"
    return "honoured" if reasoning_amount(result) == 0 else "ignored"


def toml_extra(winner):
    """The `[lane].extra` line for the winning candidate, or an empty table."""
    if winner is None:
        return "extra = {}"
    body = dict(CANDIDATES_BY_NAME[winner])
    if "chat_template_kwargs" in body:
        inner = ", ".join(f"{k} = {str(v).lower()}" for k, v in body["chat_template_kwargs"].items())
        return "extra = { chat_template_kwargs = { %s } }" % inner
    return 'extra = { reasoning_effort = "none" }'


CANDIDATES_BY_NAME = {name: extra for name, extra in CANDIDATES}


def probe(api, model, max_tokens=1600, timeout=300, log=print):
    baseline = ask(api, model, None, max_tokens, timeout)
    log(f"{'no kwarg (server default)':28s} -> {json.dumps(baseline)}")
    results, honoured = {}, []
    for name, extra in CANDIDATES:
        got = ask(api, model, extra, max_tokens, timeout)
        verdict = classify(baseline, got)
        results[name] = {**got, "verdict": verdict, "sent": extra}
        if verdict == "honoured":
            honoured.append(name)
        log(f"{name:28s} -> {verdict}: {json.dumps(got)}")
    # `both` is a superset, so it wins only when neither single spelling does — a lane should send
    # the narrowest thing that works, and a server that takes both singly takes the pair anyway.
    winner = next((n for n in ("thinking", "enable_thinking", "both", "reasoning_effort")
                   if n in honoured), None)
    return {"api": api, "model": model, "prompt": PROMPT, "prompt_case": PROMPT_CASE,
            "baseline": baseline,
            "candidates": results, "honoured": honoured, "recommended": winner,
            "lane_extra_toml": toml_extra(winner)}


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--api", required=True, help="OpenAI-compatible base URL ending in /v1")
    ap.add_argument("--model", required=True)
    ap.add_argument("--max-tokens", type=int, default=1600,
                help="the review scenario's budget: a smaller one truncates the trace"
                     " and hides where the answer would have gone")
    ap.add_argument("--timeout", type=float, default=300)
    ap.add_argument("--json", type=pathlib.Path, help="write the full result here")
    ap.add_argument("--note", default="", help="recorded with the run, as in the other probes")
    args = ap.parse_args(argv)

    api = args.api.split(",")[0]           # a pool answers the same way on either endpoint
    result = probe(api, args.model, args.max_tokens, args.timeout)
    result["note"] = args.note
    print()
    if result["recommended"]:
        print(f"honoured: {', '.join(result['honoured'])}  ->  {result['lane_extra_toml']}")
    elif not reasoning_amount(result["baseline"]):
        print("this deployment returns no reasoning trace at all; nothing to switch off")
        print(result["lane_extra_toml"])
    else:
        print("no candidate suppressed the trace; the lane has to read reasoning_content")
        print(result["lane_extra_toml"])
    if args.json:
        args.json.parent.mkdir(parents=True, exist_ok=True)
        args.json.write_text(json.dumps(result, indent=2) + "\n")
        print(f"wrote {args.json}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
